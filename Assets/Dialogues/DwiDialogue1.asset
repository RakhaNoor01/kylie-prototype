  lines:
  - speaker: 0
    text: Hi.
    animType: 1
    portrait: {fileID: -293145859814944238, guid: 9619c143d7db89845a6de442b1d85dea, type: 3}
  - speaker: 1
    text: Who are YOU.
    animType: 1
    portrait: {fileID: 21300000, guid: 15a35369aba42dc48969e5604236d623, type: 3}
  - speaker: 0
    text: Oh yeah, my bad..
    animType: 3
    portrait: {fileID: -293145859814944238, guid: 9619c143d7db89845a6de442b1d85dea, type: 3}
  - speaker: 0
    text: Name's <color=#75ffbf>Ludwig</color>.
    animType: 1
    portrait: {fileID: -293145859814944238, guid: 9619c143d7db89845a6de442b1d85dea, type: 3}
  - speaker: 0
    text: but people usually calls me <color=#75ffbf>Dwi.</color>
    animType: 0
    portrait: {fileID: -293145859814944238, guid: 9619c143d7db89845a6de442b1d85dea, type: 3}
  - speaker: 1
    text: I mean how are YOU supposed to be here.
    animType: 1
    portrait: {fileID: 21300000, guid: ad66d6aba1be69a4e8c9fa41c0964983, type: 3}
