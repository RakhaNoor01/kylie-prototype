  m_Script: {fileID: 11500000, guid: 166a482e3eae72c489a6ff4d8076c561, type: 3}
  m_Name: Dwi1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  npcDisplayName: <color=#6af7b8>Dwi</color>.
  playerDisplayName: <color=#f5c071>Kylie</color>.
  voiceClip: {fileID: 0}
  lines:
  - speaker: 1
    text: Hello, sir?
    portrait: {fileID: 21300000, guid: 1ad88008a6af75b4dacb4199e6493588, type: 3}
  - speaker: 0
    text: Just call me Ludwig, <color=#6af7b8>Dwi</color> for short.
    portrait: {fileID: 21300000, guid: 76b54b6e64aa47c42873416ccae0d2da, type: 3}
  - speaker: 1
    text: Whatever.
    portrait: {fileID: 21300000, guid: 3b37ffeaa2e8ad648843c8cd7c1465b4, type: 3}
  - speaker: 1
    text: Anyways.. how the fuck am i supposed to cross this HUGE gap.
    portrait: {fileID: 21300000, guid: 6081c0061cc18f74eb25d1568f61a4a8, type: 3}
  - speaker: 0
    text: Girl are you fucking blind?
    portrait: {fileID: 21300000, guid: 76b54b6e64aa47c42873416ccae0d2da, type: 3}
  - speaker: 0
    text: There's <color=#ff7b00>Zipline</color>. behind you, it can help you across.
    portrait: {fileID: 21300000, guid: 76b54b6e64aa47c42873416ccae0d2da, type: 3}
  - speaker: 0
    text: S o n.
    portrait: {fileID: 21300000, guid: 76b54b6e64aa47c42873416ccae0d2da, type: 3}
